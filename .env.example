# Local synthetic environment only. Replace this demo password before any public deployment.
POSTGRES_USER=pharma
POSTGRES_PASSWORD=synthetic_local_only
POSTGRES_DB=pharma
POSTGRES_PORT=55432
APP_PORT=8501
DATABASE_URL=postgresql+psycopg://pharma:synthetic_local_only@localhost:55432/pharma
# Container database URL is supplied by compose.yaml.
# SQLite fallback: DATABASE_URL=sqlite:///data/pharma_demo.db

# Phase 3: ports remain loopback-only; API token unset = all data/write routes denied.
AUTOMATION_API_PORT=8503
AUTOMATION_API_TOKEN=
AUTOMATION_CONFIG=config/automation.json
REPORT_DIR=data/reports
# Five-field cron, Asia/Kolkata. Edit config/automation.json or uncomment overrides.
# DAILY_CRON=0 8 * * *
# WEEKLY_CRON=0 9 * * mon
# SCHEDULER_TIMEZONE=Asia/Kolkata
# DQ_ASSESSMENT_AT=2026-01-01T12:00:00+00:00
MAIL_MODE=preview
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=nivara@synthetic.invalid
SMTP_RECIPIENTS=reviewer@synthetic.invalid
SMTP_ALLOWED_RECIPIENTS=
SMTP_ALLOW_EXTERNAL=false
SMTP_MAX_ATTEMPTS=3
SMTP_USERNAME=
SMTP_PASSWORD=
